{
  "manifest_version": 3,
  "key": "",
  "name": "SCOUT \u2014 MVP Affiliate",
  "version": "1.16.50",
  "description": "Companion for MVP Affiliate: grabs real YouTube frames for sharper thumbnails and reads Amazon product details.",
  "homepage_url": "https://www.mvpaffiliate.io",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://affiliate-program.amazon.com/*",
    "https://www.amazon.com/creatorconnections/*",
    "https://www.amazon.com/manage-content*",
    "https://www.amazon.com/shop/*",
    "https://www.amazon.com/dp/*",
    "https://www.amazon.com/gp/product/*",
    "https://www.amazon.com/s*",
    "https://mvpaffiliate.io/*",
    "https://www.mvpaffiliate.io/*",
    "https://*.youtube.com/*",
    "https://*.amazonaws.com/*",
    "https://*.cloudfront.net/*",
    "https://*.media-amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://*.amazon.ca/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.com.au/*",
    "https://*.walmart.com/*",
    "https://*.target.com/*",
    "https://*.bestbuy.com/*",
    "https://*.homedepot.com/*",
    "https://*.lowes.com/*",
    "https://*.wayfair.com/*",
    "https://*.etsy.com/*",
    "https://*.ebay.com/*",
    "https://*.chewy.com/*",
    "https://*.costco.com/*",
    "https://*.macys.com/*",
    "https://*.kohls.com/*",
    "https://*.newegg.com/*",
    "https://*.ulta.com/*",
    "https://*.sephora.com/*",
    "https://*.nike.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://mvpaffiliate.io/*",
      "https://*.mvpaffiliate.io/*",
      "http://localhost:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SCOUT \u2014 MVP Affiliate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://affiliate-program.amazon.com/*",
        "https://www.amazon.com/creatorconnections/*",
        "https://www.amazon.com/shop/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/shop/*"
      ],
      "js": [
        "idea-lists.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mvpaffiliate.io/*"
      ],
      "js": [
        "mvp-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "yt-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "net-hook.js"
      ],
      "matches": [
        "https://affiliate-program.amazon.com/*",
        "https://www.amazon.com/*"
      ]
    },
    {
      "resources": [
        "yt-hook.js"
      ],
      "matches": [
        "https://studio.youtube.com/*"
      ]
    }
  ]
}
